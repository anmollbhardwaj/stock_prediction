# LLM Provider Configuration for News Sentiment Analysis
# Options for LLM_PROVIDER: mock (default local fallback), gemini, openai
LLM_PROVIDER=mock

# Gemini API Key (optional - required only if LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (optional - required only if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
